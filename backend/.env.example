# Required to enable admin login
ADMIN_USERNAME=Admin
# Generate with: python scripts/generate_admin_password_hash.py
ADMIN_PASSWORD_HASH=
# Generate a random secret of at least 32 characters; keep private.
SESSION_SECRET=

# Comma-separated exact frontend origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Conservative default for CPU-bound video processing
VIDEO_WORKERS=1
# Use a persistent disk path in deployment if job files must survive restarts
JOB_STORAGE_DIR=

WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Optional OpenAI-compatible endpoint used only for Hindi translation fallback
LLM_API_KEY=
LLM_API_URL=
LLM_MODEL_ID=
